# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Flask Session Security
# Generate a random secret key for session encryption
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here-change-this

# Email Configuration (Gmail SMTP)
# IMPORTANT: You need to set up a Gmail App Password (not your regular password)
# See EMAIL_SETUP_GUIDE.md for detailed instructions
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# Site URL (pre-fills the website field on Stripe Connect onboarding)
SITE_URL=https://metex.com

# Google OAuth Credentials (Optional)
# Get these from Google Cloud Console if using OAuth login
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Production configuration — never put real secrets in this tracked file.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DATABASE_URL=
BEHIND_PROXY=true
SECURE_COOKIES=true
ENABLE_HSTS=true
UPLOADS_ROOT=
RATELIMIT_STORAGE_URL=
EMAIL_DELIVERY_ENABLED=false
EMBEDDED_FLOW_WORKER=true
# Enable only after a tax adviser reviews classifications/origins/registrations.
TAX_CONFIGURATION_APPROVED=false
TAX_PRODUCT_CODES_JSON={}
TAX_SELLER_ORIGINS_JSON={}
# Checkout, shipments, and payouts default closed in database controls.

# Pause Smart Pricing reviews without stopping payment recovery or manual seller controls.
SMART_REPRICING_ENABLED=true
